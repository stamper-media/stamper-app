{
  "name": "@stamper/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Stamper capture app (Expo): live capture, EXIF minimisation, hashing, EIP-712 claim signing, resumable upload",
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build": "tsc -p tsconfig.json --noEmit",
    "export:android": "expo export --platform android --output-dir dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --ci",
    "spike:piece": "node scripts/spike-piece-hermes.ts"
  },
