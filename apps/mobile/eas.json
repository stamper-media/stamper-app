{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_ATTEST_MODE": "stub" },
      "android": { "buildType": "apk" },
      "ios": { "simulator": false }
    },
    "development-simulator": {
      "extends": "development",
      "ios": { "simulator": true }
    },
    "preview": {
      "distribution": "store",
      "channel": "preview",
      "env": { "EXPO_PUBLIC_ATTEST_MODE": "real" },
      "android": { "buildType": "app-bundle" }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_ATTEST_MODE": "real" }
    }
  },
  "submit": {
    "preview": { "ios": {}, "android": { "track": "internal" } },
    "production": { "ios": {}, "android": { "track": "production" } }
  }
}
